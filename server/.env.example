# Copy this file to .env and fill in real values. Never commit .env.

# Main database. This default matches docker-compose.yml; use your Neon URL otherwise
# (Neon: turn "Connection pooling" off and use sslmode=verify-full).
DATABASE_URL=postgres://mailbox:mailbox@localhost:5432/mailbox
# Test database, wiped and re-seeded on every `npm test`.
DATABASE_URL_TEST=postgres://mailbox:mailbox@localhost:5432/mailbox_test

# There is no login yet, so the API treats this user as the logged-in user.
# The seed script creates the demo user first, so it gets id 1.
DEMO_USER_ID=1

# The only origin CORS allows (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
